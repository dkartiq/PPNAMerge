                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=First(Fields!CompanyInfo_Address.Value) +
 Iif(First(Fields!CompanyInfo_Address2.Value) = "","",
   ", " + Fields!CompanyInfo_Address2.Value) + ", " +
 First(Fields!CompanyInfo_City.Value) + ", " +
 First(Fields!CompanyInfo_County.Value) + "  " + 
 First(Fields!CompanyInfo_PostCode.Value) + Chr(13) + Chr(10) +
 "Phone: " + First(Fields!CompanyInfo_PhoneNo.Value) + 
 Iif(First(Fields!CompanyInfo_FaxNo.Value) = "","",
   "  Fax: " + First(Fields!CompanyInfo_FaxNo.Value))</Value>
                                  <Style />
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
