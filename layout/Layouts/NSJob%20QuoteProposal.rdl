                      <Group Name="Details" />
                      <TablixMembers>
                        <TablixMember>
                          <Visibility>
                            <Hidden>=IIF((Fields!QuoteLine_Indentation.Value = "55") AND (Fields!QuoteBySegment.Value &lt;&gt; true),false,true)</Hidden>
                          </Visibility>
                        </TablixMember>
                        <TablixMember>
                          <Visibility>
                            <Hidden>=Iif((Fields!QuoteLine_Indentation.Value = "0") AND (Fields!QuoteBySegment.Value = FALSE),false,true)</Hidden>
                          </Visibility>
                        </TablixMember>
                        <TablixMember>
                          <Visibility>
                            <Hidden>=Iif(Fields!QuoteLine_Indentation.Value="26" ,false,true)</Hidden>
                          </Visibility>
                        </TablixMember>
                        <TablixMember>
                          <Visibility>
                            <Hidden>=IIF((Fields!QuoteLine_Indentation.Value = "55") AND (Fields!QuoteBySegment.Value &lt;&gt; false),false,true)</Hidden>
                          </Visibility>
                        </TablixMember>
                        <TablixMember>
                          <Visibility>
                            <Hidden>=(Fields!QuoteBySegment.Value = FALSE) OR (Fields!QuoteLine_Indentation.Value &lt;&gt; "777")</Hidden>
                          </Visibility>
                        </TablixMember>
                        <TablixMember>
                          <Visibility>
                            <Hidden>=Iif((Fields!QuoteLine_Indentation.Value &gt; "0") and (Fields!QuoteLine_Indentation.Value &lt; "30") and
     (Fields!QuoteLine_Indentation.Value &lt;&gt; "10") and (Fields!QuoteLine_Indentation.Value &lt;&gt; "25")
         and (Fields!QuoteLine_Indentation.Value &lt;&gt; "26"),
