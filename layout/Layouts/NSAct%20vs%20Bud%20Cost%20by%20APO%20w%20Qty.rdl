                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ActivityQuantityRemaining">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(sum(Fields!Detail_Budgeted_Cost_Qty.Value) = 0,

   iif(sum(Fields!Detail_Actual_Cost_Qty.Value) = 0,
     0,
     -100
   ),

   iif(sum(Fields!Detail_Actual_Cost_Qty.Value) = 0,
     0,
     iif(sum(Fields!Detail_Budgeted_Cost_Qty.Value) = sum(Fields!Detail_Actual_Cost_Qty.Value),
       100,
       100 - round((sum(Fields!Detail_Budgeted_Cost_Qty.Value) - sum(Fields!Detail_Actual_Cost_Qty.Value)) / 
                    iif(sum(Fields!Detail_Budgeted_Cost_Qty.Value) = 0,
                      1,
                      sum(Fields!Detail_Budgeted_Cost_Qty.Value)) * 100
                    )
     )   
   )
 )</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,##0.0'%';-#,##0.0'%';'0.0%'</Format>
                                  </Style>
                                </TextRun>
