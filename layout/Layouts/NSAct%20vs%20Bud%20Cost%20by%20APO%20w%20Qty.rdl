                                <TextRun>
                                  <Value>=iif(Fields!Detail_Budgeted_Cost.Value = 0,

   iif(Fields!Detail_Actual_Cost.Value = 0,
     0,
     -100
   ),

   iif(Fields!Detail_Actual_Cost.Value = 0,
     0,
     iif(Fields!Detail_Budgeted_Cost.Value = Fields!Detail_Actual_Cost.Value,
       100,
       100 - round((Fields!Detail_Budgeted_Cost.Value - Fields!Detail_Actual_Cost.Value) / 
                    iif(Fields!Detail_Budgeted_Cost.Value = 0,
                      1,
                      Fields!Detail_Budgeted_Cost.Value) * 100
                    )
     )   
   )
 )</Value>
                                  <Style>
