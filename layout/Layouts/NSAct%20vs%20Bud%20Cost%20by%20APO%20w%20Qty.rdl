                <TablixMember>
                  <Group Name="Job">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Job_No.Value</GroupExpression>
                    </GroupExpressions>
                    <PageBreak>
                      <BreakLocation>Between</BreakLocation>
                    </PageBreak>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!Job_No.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <TablixMembers>
                    <TablixMember />
                    <TablixMember />
                    <TablixMember />
                    <TablixMember>
                      <Group Name="Activity">
                        <GroupExpressions>
                          <GroupExpression>=Fields!Activity_Code.Value</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!Activity_Code.Value</Value>
                        </SortExpression>
                      </SortExpressions>
                      <TablixMembers>
                        <TablixMember />
                        <TablixMember>
                          <Group Name="Process">
                            <GroupExpressions>
                              <GroupExpression>=Fields!Process_Code.Value</GroupExpression>
                            </GroupExpressions>
                          </Group>
                          <SortExpressions>
                            <SortExpression>
                              <Value>=Fields!Process_Code.Value</Value>
                            </SortExpression>
                          </SortExpressions>
                          <TablixMembers>
                            <TablixMember>
                              <Visibility>
                                <Hidden>=iif((Fields!Show_Operations.Value and (Fields!Operation_Description.Value &gt; "")) or (Fields!Show_Processes.Value and Fields!Show_Details.Value and (Fields!Process_Description.Value &gt; "")) ,false,true)</Hidden>
                              </Visibility>
                            </TablixMember>
                            <TablixMember>
                              <Group Name="Operation">
                                <GroupExpressions>
                                  <GroupExpression>=Fields!Operation_Code.Value</GroupExpression>
                                </GroupExpressions>
                              </Group>
                              <SortExpressions>
                                <SortExpression>
                                  <Value>=Fields!Operation_Code.Value</Value>
                                </SortExpression>
                              </SortExpressions>
                              <TablixMembers>
                                <TablixMember>
                                  <Visibility>
                                    <Hidden>=iif(Fields!Show_Operations.Value and Fields!Show_Details.Value,FALSE,TRUE)</Hidden>
                                  </Visibility>
                                </TablixMember>
                                <TablixMember>
                                  <Group Name="Section_code">
                                    <GroupExpressions>
                                      <GroupExpression>=Fields!Section_code.Value</GroupExpression>
                                    </GroupExpressions>
                                  </Group>
                                  <SortExpressions>
                                    <SortExpression>
                                      <Value>=Fields!Section_code.Value</Value>
