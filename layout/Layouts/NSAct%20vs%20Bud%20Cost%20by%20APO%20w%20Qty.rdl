  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function JobRemaining(Budget As Decimal, Actual As Decimal)
   Return (Budget - Actual)
End Function


Public Function JobPctRemaining(Budget As Decimal, Remaining As Decimal)

   IF ((Remaining = 0) AND (Budget &gt; 0)) THEN 
      Return 100 
   END IF
   IF (Remaining = 0) AND (Budget &lt; 0) THEN 
      Return -100 
   END IF
   IF (Remaining = 0) AND (Budget = 0) THEN 
      Return 0 
   END IF

   IF (Remaining &lt;&gt; 0) AND (Budget &lt;&gt; 0) THEN 
      Return 100 - (Remaining / Budget * 100)
   END IF
   IF (Remaining &lt;&gt; 0) AND (Budget = 0) THEN 
      Return -100
   END IF

End Function</Code>
