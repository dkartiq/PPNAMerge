     -100
   ),

   iif(sum(Fields!Detail_Actual_Cost.Value) = 0,
     0,
     iif(sum(Fields!Detail_Budgeted_Cost.Value) = sum(Fields!Detail_Actual_Cost.Value),
       100,
       100 - round((sum(Fields!Detail_Budgeted_Cost.Value) - sum(Fields!Detail_Actual_Cost.Value)) / 
                    iif(sum(Fields!Detail_Budgeted_Cost.Value) = 0,
                      1,
                      sum(Fields!Detail_Budgeted_Cost.Value)) * 100
                    )
     )   
   )
 )</Value>
