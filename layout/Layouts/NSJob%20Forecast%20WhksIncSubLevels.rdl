                    <TablixCell />
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="NetCostVariance">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Sum(Fields!Budgeted_Costs.Value) - Sum(Fields!Total_Costs_Used.Value)) - (Sum(Fields!New_Forecasted_Completed_Cost.Value) - Sum(Fields!Total_Costs_Used.Value))</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <Format>=First(Fields!Total_Forecasted_Completed_CostFormat.Value)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
