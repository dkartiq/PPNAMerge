                    <TablixCell>
                      <CellContents>
                        <Textbox Name="GrossMarginsPercent_4">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(Sum(Fields!New_Forecasted_Completed_Cost.Value) = 0, 0, System.Math.ROUND(Fields!Contracted_Amount.Value * Sum(Fields!Total_Costs_Used.Value) / iif(Sum(Fields!New_Forecasted_Completed_Cost.Value) = 0, 1, Sum(Fields!New_Forecasted_Completed_Cost.Value)) - Sum(Fields!Total_Costs_Used.Value), Fields!FinalRoundingDec.Value)) / iif(Sum(Fields!New_Forecasted_Completed_Cost.Value) = 0, 0, System.Math.ROUND(Fields!Contracted_Amount.Value * Sum(Fields!Total_Costs_Used.Value) / iif(Sum(Fields!New_Forecasted_Completed_Cost.Value) = 0, 1, Sum(Fields!New_Forecasted_Completed_Cost.Value)), Fields!FinalRoundingDec.Value)) * 100</Value>
                                  <Style>
                                    <FontSize>6pt</FontSize>
                                    <Format>=First(Fields!Total_Forecasted_Completed_CostFormat.Value)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style>
