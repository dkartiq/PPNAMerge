  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Shared Counter As Integer
Public Shared Record
Public Function PageBreak(Byval Field,ByVal IsPageBreak)
    if IsPageBreak and Record &lt;&gt; Field
       Counter = Counter + 1
    end if 
    Record = Field
    Return Counter
End Function

Public Shared ComInfo As Object
Public Shared StatusCap As Object
Public Shared PageNoCaption As Object

Public Function SetValue(ByVal Com, ByVal Sta, ByVal Pag)
ComInfo=Com
StatusCap=Sta
PageNoCaption=Pag
End Function
