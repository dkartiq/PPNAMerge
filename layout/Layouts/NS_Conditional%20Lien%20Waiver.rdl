          <Textbox Name="Textbox20">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Dollars, and other good and valuable considerations, upon receipt whereof is hereby acknowledged, do(es) hereby conditionally waive and</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
