                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DetailBudgetCostPctUsed">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(Fields!DetailBudgetedCost.Value = 0,

   iif(Fields!DetailActualCost.Value = 0,
     0,
     -100
   ),

   iif(Fields!DetailActualCost.Value = 0,
     0,
     iif(Fields!DetailBudgetedCost.Value = Fields!DetailActualCost.Value,
       100,
       100 - round((Fields!DetailBudgetedCost.Value - Fields!DetailActualCost.Value) / 
                    iif(Fields!DetailBudgetedCost.Value = 0,
                      1,
                      Fields!DetailBudgetedCost.Value) * 100
                    )
     )   
   )
 )</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <Format>#,##0.0;-#,##0.0;0.0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
