                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ProcessBudgetCostPctUsed">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(sum(Fields!DetailBudgetedCost.Value) = 0,

   iif(sum(Fields!DetailActualCost.Value) = 0,
     0,
     -100
   ),

   iif(sum(Fields!DetailActualCost.Value) = 0,
     0,
     iif(sum(Fields!DetailBudgetedCost.Value) = sum(Fields!DetailActualCost.Value),
       100,
       100 - round((sum(Fields!DetailBudgetedCost.Value) - sum(Fields!DetailActualCost.Value)) / 
                    iif(sum(Fields!DetailBudgetedCost.Value) = 0,
                      1,
                      sum(Fields!DetailBudgetedCost.Value)) * 100
                    )
     )   
   )
 )</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,##0.0;-#,##0.0;0.0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
