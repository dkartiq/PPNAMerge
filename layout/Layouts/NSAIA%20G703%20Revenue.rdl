                      <CellContents>
                        <Textbox Name="ScheduledValue3">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!ScheduledValue.Value)</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
