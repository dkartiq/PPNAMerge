            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>That there are no other contracts for said work outstanding, and that there is nothing due or to become due to any person for material, labor or other work of any kind done or to be done upon or in connection with said work other than above stated.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
