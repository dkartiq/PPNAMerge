                                  <Value>=Microsoft.VisualBasic.Interaction.iif(Sum(Fields!DetailBudgetedCostQty.Value) = 0, Microsoft.VisualBasic.Interaction.iif(Sum(Fields!DetailActualCostQty.Value) = 0, 0, - 100), Microsoft.VisualBasic.Interaction.iif(Sum(Fields!DetailActualCostQty.Value) = 0, 0, Microsoft.VisualBasic.Interaction.iif(Sum(Fields!DetailBudgetedCostQty.Value) = Sum(Fields!DetailActualCostQty.Value), 100, 100 - System.Math.round((Sum(Fields!DetailBudgetedCostQty.Value) - Sum(Fields!DetailActualCostQty.Value)) / Microsoft.VisualBasic.Interaction.iif(Sum(Fields!DetailBudgetedCostQty.Value) = 0, 1, Sum(Fields!DetailBudgetedCostQty.Value)) * 100))))</Value>
