                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Code.DivideByZero(Sum(Fields!DetailBudgetedCost.Value),Sum(Fields!DetailBudgetedWorkUnits.Value),Sum(Fields!DetailActualCost.Value),Sum(Fields!DetailActualWorkUnits.Value))</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
