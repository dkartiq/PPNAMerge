-(iif(Sum(Fields!DetailActualWorkUnits.Value)=0,0,Sum(Fields!DetailActualCost.Value)/iif(Sum(Fields!DetailActualWorkUnits.Value)=0,1,Sum(Fields!DetailActualWorkUnits.Value)))))</Value>
