     ,

     iif(Fields!DetailBudgetedCostPerUnit.Value = Fields!DetailActualCostPerUnit.Value,


         100,

         100 * round((Fields!DetailActualCostPerUnit.Value - Fields!DetailBudgetedCostPerUnit.Value) /

  
