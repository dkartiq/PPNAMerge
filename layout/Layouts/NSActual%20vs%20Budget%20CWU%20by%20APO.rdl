                        <Textbox Name="JobWorkUnitsVariance">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!DetailBudgetedWorkUnits.Value) - 
Sum(Fields!DetailActualWorkUnits.Value)</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>=First(Fields!DetailBudgetedWorkUnitsFormat.Value, "DataSet_Result")</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
