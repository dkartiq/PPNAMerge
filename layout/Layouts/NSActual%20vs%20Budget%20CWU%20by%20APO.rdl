                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(Fields!DetailBudgetedWorkUnits.Value = 0,


     
     iif(Fields!DetailActualWorkUnits.Value = 0,


         0,


         -100


        ),



     iif(Fields!DetailActualWorkUnits.Value = 0,


        0,


        iif(Fields!DetailBudgetedWorkUnits.Value = Fields!DetailActualWorkUnits.Value,


           100,


           100 - round((Fields!DetailBudgetedWorkUnits.Value - 

                              Fields!DetailActualWorkUnits.Value) / 

 
                                  iif(Fields!DetailBudgetedWorkUnits.Value = 0,


                                     1,


                                     Fields!DetailBudgetedWorkUnits.Value) * 100


                                  )


          )

    )


 )</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <Format>#,##0.0;-#,##0.0;0.0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
