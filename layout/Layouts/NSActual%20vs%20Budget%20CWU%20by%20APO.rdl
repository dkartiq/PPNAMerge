  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function JobRemaining(Budget As Decimal, Actual As Decimal)
   Return (Budget - Actual)
End Function


Public Function JobPctRemaining(Budget As Decimal, Remaining As Decimal)

   IF ((Remaining = 0) AND (Budget &gt; 0)) THEN 
      Return 100 
   END IF
   IF (Remaining = 0) AND (Budget &lt; 0) THEN 
      Return -100 
   END IF
   IF (Remaining = 0) AND (Budget = 0) THEN 
      Return 0 
   END IF

   IF (Remaining &lt;&gt; 0) AND (Budget &lt;&gt; 0) THEN 
      Return 100 - (Remaining / Budget * 100)
   END IF
   IF (Remaining &lt;&gt; 0) AND (Budget = 0) THEN 
      Return -100
   END IF

End Function

Public Shared Function DivideByZero(ByVal Numerator1 As Decimal, ByVal Denominator1 As Decimal,ByVal Numerator2 As Decimal, ByVal Denominator2 As Decimal) As Decimal
   IF (Denominator1 &gt; 0) AND (Denominator2 &gt; 0) AND (Numerator1 &gt; 0) AND (Numerator2 &gt; 0)  Then
      Return (((Numerator1  / Denominator1)/(Numerator2 / Denominator2))*100)
   End If
   Return 0
End Function</Code>
