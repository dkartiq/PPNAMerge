                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(SUM(Fields!DetailBudgetedWorkUnits.Value) = 0,



     iif(SUM(Fields!DetailActualWorkUnits.Value) = 0,
         0,

         -100


        ),
     iif(SUM(Fields!DetailActualWorkUnits.Value) = 0,
        0,


        iif(SUM(Fields!DetailBudgetedWorkUnits.Value) = SUM(Fields!DetailActualWorkUnits.Value),
           100,
           100 - round((SUM(Fields!DetailBudgetedWorkUnits.Value) - 
                              SUM(Fields!DetailActualWorkUnits.Value)) / 
 
                                  iif(SUM(Fields!DetailBudgetedWorkUnits.Value) = 0,
                                     1,

                                     SUM(Fields!DetailBudgetedWorkUnits.Value)) * 100

                                  )

          )
    )

 )</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
